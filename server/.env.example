# =========================================
# WebRTC Audio Streamer - Environment Config
# =========================================

# --- Security ---
# Secret key used for signing JWT tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_change_me_in_production
# Initial password for the admin account
ADMIN_PASSWORD=change_this_admin_password
# Session secret
SESSION_SECRET=your_session_secret_key_here

# --- Server & Static Client ---
PORT=8080
NODE_ENV=production
# Path to static client build relative to server directory (default: ../client)
CLIENT_DIR=../client
# Allowed CORS origins (comma-separated domains, or * for all)
ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com

# --- Redis Storage & Pub/Sub ---
REDIS_URL=redis://localhost:6379

# --- STUN / TURN Relay Server ---
# TURN server credentials for relaying WebRTC traffic when P2P fails
TURN_URL=turn:your-turn-server.com:3478
TURNS_URL=turns:your-turn-server.com:443
# Secret key shared with coturn / TURN server for dynamic REST API credential generation
TURN_SECRET=your_coturn_shared_secret_key

# --- Email Notifications (SMTP / AWS SES) ---
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Audio Streamer" <no-reply@yourdomain.com>

# --- Social Authentication ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="your_apple_private_key"

# --- Payments (PayPal Integration) ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox # sandbox or live
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
